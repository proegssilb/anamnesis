# Production values for the Compose stack. Copy to `.env` beside compose.yaml
# and fill in. This file differs from the repo-root .env.example in one way
# that matters: dev-auth bypass is absent, and every OIDC variable is
# therefore mandatory.
#
#   cp deploy/compose.env.example .env
#
# `.env` holds two real secrets. Keep it out of version control (the repo's
# .gitignore already excludes it) and mode 0600.

# The externally-reachable URL, which must match what users type and what your
# identity provider has registered as the redirect URI. Its `https://` prefix
# is also what makes the session cookie `Secure`.
ANAMNESIS_BASE_URL=https://anamnesis.example.com

# --- OpenID Connect ---------------------------------------------------------
# Your provider's issuer URL: the one that serves
# {issuer}/.well-known/openid-configuration. Anamnesis discovers everything
# else from there.
ANAMNESIS_OIDC_ISSUER_URL=https://id.example.com/application/o/anamnesis/
ANAMNESIS_OIDC_CLIENT_ID=anamnesis
ANAMNESIS_OIDC_CLIENT_SECRET=

# Register exactly this redirect URI with the provider:
#   https://anamnesis.example.com/auth/callback

# Uncomment if your identity provider's certificate is issued by a private CA.
# Anamnesis reads nothing from the system trust store, so this is the only way
# to trust one. Mount the PEM file into the container read-only.
# ANAMNESIS_TLS_CA_BUNDLE=/etc/anamnesis/ca.crt

# --- Sessions ---------------------------------------------------------------
# At least 64 bytes, and STABLE ACROSS RESTARTS: rotating it invalidates every
# signed cookie and logs every user out. Generate once and keep it:
#
#   openssl rand -base64 64 | tr -d '\n'
#
# Do not template this from anything that regenerates on deploy.
ANAMNESIS_SESSION_SECRET=

# --- Time zone and first admin ----------------------------------------------
# An IANA zone name, validated at startup against the tzdb compiled into the
# binary (no system tzdata package needed). It is what makes a recurring
# schedule like "every other Monday" mean anything.
ANAMNESIS_TIMEZONE=America/New_York

# The OIDC subject (`sub` claim) granted System Admin the first time an empty
# database boots. There is no web UI to grant the first role, so this must be
# an identity you can actually log in as.
ANAMNESIS_BOOTSTRAP_ADMIN=

# --- Optional ---------------------------------------------------------------
# Largest request body accepted, in bytes. Default 41943040 (40 MiB). This is
# the only cap on an attachment upload. If you change it, change the proxy's
# limit in deploy/Caddyfile.example to match.
# ANAMNESIS_MAX_BODY_BYTES=41943040

# RUST_LOG=info

# ANAMNESIS_DEV_AUTH_BYPASS is deliberately NOT set here. It authenticates
# every request as a fixed local user with no identity provider involved —
# anything that can reach the port is logged in. Never set it in a real
# deployment.
