# /etc/anamnesis/anamnesis.env — install as 0640 root:anamnesis.
#
# systemd parses this itself, not a shell: no `export`, no command
# substitution, and no quotes unless you want the quotes in the value.

# --- Database ---------------------------------------------------------------
# Postgres is the default for a VM, where a real database server is usually
# already available and worth using. `sslmode=verify-full` is the only setting
# that actually authenticates the server; add sslrootcert when the certificate
# comes from a private CA (no application change is needed for this — sqlx
# reads it straight out of the URL, and honours PGSSLROOTCERT too).
ANAMNESIS_DATABASE_URL=postgres://anamnesis:CHANGEME@localhost/anamnesis?sslmode=verify-full&sslrootcert=/etc/anamnesis/ca.crt

# No Postgres? Comment the line above and uncomment this one. Nothing else in
# this file changes: both backends run the same schema, migrated at startup.
# ANAMNESIS_DATABASE_URL=sqlite:///var/lib/anamnesis/anamnesis.db?mode=rwc

# --- Networking -------------------------------------------------------------
# Loopback only. The reverse proxy is what should be reachable from outside;
# this way no firewall rule is load-bearing.
ANAMNESIS_BIND_ADDR=127.0.0.1:8080

# The externally-reachable URL — what users type and what the identity
# provider has registered as the redirect URI. Its `https://` prefix is what
# makes the session cookie `Secure`.
ANAMNESIS_BASE_URL=https://anamnesis.example.com

# --- Storage ----------------------------------------------------------------
# Inside StateDirectory=anamnesis, which systemd creates and chowns. Back this
# up together with the database: an attachment row whose blob is missing is a
# broken download.
ANAMNESIS_BLOB_ROOT=/var/lib/anamnesis/blobs

# --- OpenID Connect ---------------------------------------------------------
ANAMNESIS_OIDC_ISSUER_URL=https://id.example.com/application/o/anamnesis/
ANAMNESIS_OIDC_CLIENT_ID=anamnesis
ANAMNESIS_OIDC_CLIENT_SECRET=CHANGEME

# Private CA for the identity provider. Anamnesis reads nothing from the
# system trust store, so neither SSL_CERT_FILE nor /etc/ssl/certs will do.
# ANAMNESIS_TLS_CA_BUNDLE=/etc/anamnesis/ca.crt

# --- Sessions ---------------------------------------------------------------
# At least 64 bytes, generated ONCE and kept: rotating it logs every user out.
#   openssl rand -base64 64 | tr -d '\n'
ANAMNESIS_SESSION_SECRET=CHANGEME

# --- Time zone and first admin ----------------------------------------------
ANAMNESIS_TIMEZONE=America/New_York
ANAMNESIS_BOOTSTRAP_ADMIN=CHANGEME

# --- Optional ---------------------------------------------------------------
# ANAMNESIS_MAX_BODY_BYTES=41943040
RUST_LOG=info
