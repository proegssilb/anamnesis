# Anamnesis — environment configuration
#
# Copy this file to `.env` and fill in real values, or export the same
# variables however your deployment prefers (systemd EnvironmentFile,
# a container's `env:`, etc). Anamnesis does not load `.env` itself at
# runtime — it reads the process environment directly (see
# crates/anamnesis-web/src/config.rs) — so use `direnv`, `dotenvx run`,
# `docker run --env-file`, or export the variables yourself before
# `cargo run` / the compiled binary.
#
# Every variable here is read exactly once, at startup, into a typed
# Config. A missing required variable or a malformed value fails loudly,
# naming the variable — nothing silently falls back to an undocumented
# default.

# --- Database ------------------------------------------------------------

# REQUIRED. No default.
# Selects the storage backend by URL scheme:
#   sqlite://path/to/file.db?mode=rwc   -> SQLite (single-user / small deployments)
#   postgres://user:pass@host:port/db   -> PostgreSQL (also accepts postgresql://)
# Any other scheme is a startup error naming both supported forms.
# For SQLite, `?mode=rwc` creates the file if it does not already exist.
ANAMNESIS_DATABASE_URL=sqlite://anamnesis.db?mode=rwc

# --- Networking ------------------------------------------------------------

# Optional. Default: 0.0.0.0:8080
# The address:port the HTTP server binds to. Must parse as a Rust
# `SocketAddr` (host as a literal IP, not a hostname; e.g. 127.0.0.1:8080
# or 0.0.0.0:8080), or startup fails naming this variable.
ANAMNESIS_BIND_ADDR=0.0.0.0:8080

# REQUIRED. No default.
# The externally-reachable base URL of this deployment, no trailing slash
# required (trailing slash is stripped where it matters). Used to build the
# OIDC redirect URI ("${ANAMNESIS_BASE_URL}/auth/callback") and to decide
# whether the session cookie gets the `Secure` attribute — anything starting
# with "https://" is treated as HTTPS.
ANAMNESIS_BASE_URL=http://localhost:8080

# --- OpenID Connect (delegated login) --------------------------------------
#
# Anamnesis never stores a password; it delegates login to any OIDC-compliant
# provider via OAuth2 Authorization Code + PKCE. These three variables are
# REQUIRED unless ANAMNESIS_DEV_AUTH_BYPASS is enabled below, in which case
# they are optional and ignored. See README.md for a worked Authentik
# example — Authentik is not special-cased; any compliant provider works.

# The provider's issuer URL. Anamnesis fetches
# "${ANAMNESIS_OIDC_ISSUER_URL}/.well-known/openid-configuration" from it at
# startup to discover endpoints and keys.
ANAMNESIS_OIDC_ISSUER_URL=https://idp.example.com/application/o/anamnesis/

# The OAuth2 client ID registered with the provider for this application.
ANAMNESIS_OIDC_CLIENT_ID=anamnesis

# The OAuth2 client secret registered with the provider for this application.
# Treat this as a real secret — do not commit it.
ANAMNESIS_OIDC_CLIENT_SECRET=change-me

# Optional. Default: "openid profile email"
# Space-separated OAuth2/OIDC scopes requested during login.
ANAMNESIS_OIDC_SCOPES=openid profile email

# --- Sessions ------------------------------------------------------------

# REQUIRED. No default. Must be at least 64 bytes long (checked by byte
# length, not entropy — use a long random value, not a short readable one).
# Signs and verifies the session cookie (which carries the user id, display
# name, and CSRF token). Generate one with, e.g.:
#   openssl rand -hex 64
ANAMNESIS_SESSION_SECRET=

# --- Time zone & bootstrap admin --------------------------------------------

# REQUIRED. No default.
# An IANA time zone name (e.g. "America/New_York", "Europe/Berlin",
# "America/Sao_Paulo") — every local-calendar calculation the suggestion
# engine and the archive sweep make (docs/DOMAIN.md §6: "'every other
# Monday' is meaningless without one") is resolved against this zone.
# Validated for real at startup against a real IANA tzdb (crates/anamnesis-
# adapters/src/timezone.rs, via the `time-tz` crate — no system tzdb
# required) — an unrecognised name fails startup loudly, naming the
# variable, rather than silently defaulting to UTC.
ANAMNESIS_TIMEZONE=America/New_York

# REQUIRED. No default.
# The subject (the OIDC `sub` claim, or the fixed dev-bypass user id
# "dev-user" when ANAMNESIS_DEV_AUTH_BYPASS is set) granted System Admin on
# every startup of an empty-of-admins database — see
# crates/anamnesis-web/src/bootstrap.rs. Idempotent: on every later boot
# this subject already holds System Admin, so the grant is a no-op and
# nothing is logged. It is *not* a one-shot latch — naming a different
# subject on a later boot grants System Admin to that subject too, it does
# not replace the first. The same bootstrap pass also seeds the three
# default board columns (To-Do, WIP-limited; Doing; Done) the first time the
# board has none.
#
# There is currently no web UI to grant roles to any *other* user — set
# this to your own identity (the value your IdP's `sub` claim will hold, or
# "dev-user" for the bypass quickstart) so you have somewhere to start from.
ANAMNESIS_BOOTSTRAP_ADMIN=dev-user

# --- File attachments ------------------------------------------------------

# Optional. Default: ./data/blobs
# The local filesystem directory attachment file bytes are stored under
# (docs/DOMAIN.md §3's BlobStore — local filesystem now, S3-shaped later).
# Created on first use if it does not exist. Unlike every REQUIRED variable
# above, an unset value here is not a startup error — it is not security- or
# correctness-sensitive the way ANAMNESIS_SESSION_SECRET is.
ANAMNESIS_BLOB_ROOT=./data/blobs

# --- Development / testing only --------------------------------------------

# Optional. Default: false (unset, empty, or anything other than
# 1/true/yes/on, case-insensitively, means disabled).
#
# DEV/TEST ONLY. DANGEROUS IN PRODUCTION. When enabled, every request is
# authenticated as a fixed local user (subject "dev-user") with NO identity
# provider involved — ANAMNESIS_OIDC_* becomes optional and is ignored, and
# anyone who can reach the server is treated as logged in. Anamnesis logs a
# loud warning on every startup while this is set. Use it only for local
# development and automated tests; never set it in a real deployment.
ANAMNESIS_DEV_AUTH_BYPASS=1

# --- Logging (not validated by Config, but read at startup) ----------------

# Optional. Default: "info". Standard `tracing-subscriber` EnvFilter syntax,
# e.g. "anamnesis_web=debug,tower_http=debug,info". Not part of the typed
# Config and not required, but genuinely read by the binary at startup, so
# it is documented here too.
RUST_LOG=info
